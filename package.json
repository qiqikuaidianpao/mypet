{
  "name": "mypet",
  "version": "1.4.1",
  "description": "A tamagotchi-style desktop pet for DeepSeek Harness — living skins that blink & wag, weather + time-of-day ambience, weekly report cards, a fetch mini-game, 24 collectible skins, achievements and synthesized sounds. 电子宠物：会眨眼摇尾巴、看天气看时辰、还能接球。",
  "type": "module",
  "main": "lib/index.js",
  "homepage": "https://github.com/qiqikuaidianpao/mypet#readme",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqikuaidianpao/mypet.git"
  },
  "bugs": {
    "url": "https://github.com/qiqikuaidianpao/mypet/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build && npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "pet",
    "tamagotchi",
    "companion",
    "desktop-pet",
    "coding-companion"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true }
  }
}
